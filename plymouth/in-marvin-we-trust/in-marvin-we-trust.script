# Plymouth's script plugin runs before Plasma starts. Keep all assets local to
# this theme so the initramfs can include them.
Window.SetBackgroundTopColor(0.02, 0.02, 0.02);
Window.SetBackgroundBottomColor(0.02, 0.02, 0.02);

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();
screen_x = Window.GetX();
screen_y = Window.GetY();
scale = screen_width / 1280;
if (screen_height / 720 < scale)
  scale = screen_height / 720;
if (scale < 0.5)
  scale = 0.5;

red_image = Image("red.png");
dim_image = Image("dim-red.png");
rail_image = Image("rail.png");

wordmark_image = Image("wordmark.png");
wordmark_image = wordmark_image.Scale(Math.Int(680 * scale), Math.Int(54 * scale));
wordmark = Sprite(wordmark_image);
wordmark.SetPosition(screen_x + screen_width / 2 - wordmark_image.GetWidth() / 2,
                     screen_y + screen_height * 0.09, 2);

marvin_image = Image("marvin.png");
marvin_image = marvin_image.Scale(Math.Int(331 * scale), Math.Int(400 * scale));
marvin = Sprite(marvin_image);
marvin.SetPosition(screen_x + screen_width / 2 - marvin_image.GetWidth() / 2,
                   screen_y + screen_height * 0.215, 2);

# Thin top and bottom rules match the Plasma splash without a full-screen PNG.
rule_image = red_image.Scale(Math.Int(screen_width), Math.Int(2 * scale));
top_rule = Sprite(rule_image);
top_rule.SetPosition(screen_x, screen_y, 1);
top_rule.SetOpacity(0.75);
bottom_rule = Sprite(rule_image);
bottom_rule.SetPosition(screen_x, screen_y + screen_height - rule_image.GetHeight(), 1);
bottom_rule.SetOpacity(0.35);

corner_long = red_image.Scale(Math.Int(38 * scale), Math.Int(2 * scale));
corner_tall = red_image.Scale(Math.Int(2 * scale), Math.Int(38 * scale));
top_corner_h = Sprite(corner_long);
top_corner_h.SetPosition(screen_x + 48 * scale, screen_y + 48 * scale, 2);
top_corner_v = Sprite(corner_tall);
top_corner_v.SetPosition(screen_x + 48 * scale, screen_y + 48 * scale, 2);
bottom_corner_h = Sprite(corner_long);
bottom_corner_h.SetPosition(screen_x + screen_width - 86 * scale,
                            screen_y + screen_height - 50 * scale, 2);
bottom_corner_v = Sprite(corner_tall);
bottom_corner_v.SetPosition(screen_x + screen_width - 50 * scale,
                            screen_y + screen_height - 86 * scale, 2);

caption_image = Image.Text("BENVENUTO NEL MULTIVERSO", 0.98, 0.22, 0.29);
caption = Sprite(caption_image);
caption.SetPosition(screen_x + screen_width / 2 - caption_image.GetWidth() / 2,
                    screen_y + screen_height * 0.785, 3);

slogan_image = Image("encryption-slogan.png");
slogan_image = slogan_image.Scale(Math.Int(488 * scale), Math.Int(40 * scale));
slogan = Sprite(slogan_image);
slogan.SetPosition(screen_x + screen_width / 2 - slogan_image.GetWidth() / 2,
                   screen_y + screen_height * 0.77, 3);
slogan.SetOpacity(0);

track_width = Math.Int(580 * scale);
track_height = Math.Int(12 * scale);
track_x = screen_x + screen_width / 2 - track_width / 2;
track_y = screen_y + screen_height * 0.88;
track = Sprite(rail_image.Scale(track_width, track_height));
track.SetPosition(track_x, track_y, 2);

segment_width = Math.Int(track_width / 24 - 2 * scale);
if (segment_width < 2)
  segment_width = 2;
segment_image = red_image.Scale(segment_width, track_height - 2);
segment_dim_image = dim_image.Scale(segment_width, track_height - 2);
for (i = 0; i < 24; i++)
  {
    segments[i] = Sprite(segment_dim_image);
    segments[i].SetPosition(track_x + Math.Int(i * track_width / 24) + 1,
                            track_y + 1, 3);
  }

status_image = Image.Text("AVVIO DEL SISTEMA", 0.98, 0.22, 0.29);
status = Sprite(status_image);
status.SetPosition(track_x, track_y - 29 * scale, 3);

progress = 0;
frame = 0;
mode = "normal";

fun progress_callback(duration, fraction)
  {
    if (fraction < 0)
      fraction = 0;
    if (fraction > 1)
      fraction = 1;
    global.progress = fraction;
  }
Plymouth.SetBootProgressFunction(progress_callback);

fun refresh_callback()
  {
    global.frame++;
    lit = Math.Int(progress * 24);
    pulse = Math.Int(frame / 5);
    pulse = pulse - Math.Int(pulse / 24) * 24;
    for (i = 0; i < 24; i++)
      {
        if (mode != "normal")
          segments[i].SetOpacity(0);
        else if (i < lit)
          {
            segments[i].SetImage(segment_image);
            segments[i].SetOpacity(1);
          }
        else
          {
            segments[i].SetImage(segment_dim_image);
            if (i == pulse && mode == "normal")
              segments[i].SetOpacity(0.9);
            else
              segments[i].SetOpacity(0.65);
          }
      }
  }
Plymouth.SetRefreshFunction(refresh_callback);

prompt_sprite = Sprite();
entry_sprite = Sprite();
bullets_sprite = Sprite();
prompt_y = screen_y + screen_height * 0.83;

fun display_password_callback(prompt, bullets)
  {
    global.mode = "password";
    caption.SetOpacity(0);
    slogan.SetOpacity(1);
    status.SetOpacity(0);
    track.SetOpacity(0);
    for (i = 0; i < 24; i++)
      segments[i].SetOpacity(0);

    prompt_image = Image.Text(prompt, 0.98, 0.22, 0.29);
    if (prompt_image.GetWidth() > screen_width * 0.85)
      prompt_image = prompt_image.Scale(Math.Int(screen_width * 0.85),
                                        Math.Int(prompt_image.GetHeight() * screen_width * 0.85 / prompt_image.GetWidth()));
    prompt_sprite.SetImage(prompt_image);
    prompt_sprite.SetPosition(screen_x + screen_width / 2 - prompt_image.GetWidth() / 2,
                              prompt_y, 10);
    prompt_sprite.SetOpacity(1);

    entry_image = rail_image.Scale(Math.Int(300 * scale), Math.Int(30 * scale));
    entry_sprite.SetImage(entry_image);
    entry_sprite.SetPosition(screen_x + screen_width / 2 - entry_image.GetWidth() / 2,
                             prompt_y + 24 * scale, 10);
    entry_sprite.SetOpacity(1);

    # Only the bullet count is provided by Plymouth; never draw password text.
    bullet_text = "";
    for (i = 0; i < bullets && i < 40; i++)
      bullet_text += "*";
    bullets_image = Image.Text(bullet_text, 0.98, 0.22, 0.29);
    bullets_sprite.SetImage(bullets_image);
    bullets_sprite.SetPosition(screen_x + screen_width / 2 - bullets_image.GetWidth() / 2,
                               prompt_y + 30 * scale, 11);
    bullets_sprite.SetOpacity(1);
  }
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback()
  {
    global.mode = "normal";
    prompt_sprite.SetOpacity(0);
    entry_sprite.SetOpacity(0);
    bullets_sprite.SetOpacity(0);
    caption.SetOpacity(1);
    slogan.SetOpacity(0);
    status.SetOpacity(1);
    track.SetOpacity(1);
  }
Plymouth.SetDisplayNormalFunction(display_normal_callback);

message_sprite = Sprite();
fun display_message_callback(message)
  {
    message_image = Image.Text(message, 1, 1, 1);
    message_sprite.SetImage(message_image);
    message_sprite.SetPosition(screen_x + screen_width / 2 - message_image.GetWidth() / 2,
                               screen_y + screen_height * 0.94, 12);
    message_sprite.SetOpacity(1);
  }
Plymouth.SetDisplayMessageFunction(display_message_callback);

fun hide_message_callback(message)
  {
    message_sprite.SetOpacity(0);
  }
Plymouth.SetHideMessageFunction(hide_message_callback);
